---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Indian Keto"
  description="The page you're looking for doesn't exist. Browse our Indian keto articles and recipes instead."
  noindex={true}
>
  <section class="py-24">
    <div class="max-w-xl mx-auto px-4 text-center">
      <div class="text-8xl mb-6">🥘</div>
      <h1 class="text-4xl font-display font-semibold text-primary mb-4">Page Not Found</h1>
      <p class="text-lg text-neutral-600 mb-8">
        The page you're looking for doesn't exist. But we have plenty of Indian keto content for you!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn btn-primary btn-lg">Go Home</a>
        <a href="/articles" class="btn btn-secondary btn-lg">Browse Articles</a>
      </div>
    </div>
  </section>
</BaseLayout>
