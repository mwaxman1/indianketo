---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
---

<BaseLayout
  title="Privacy Policy — Indian Keto"
  description="Indian Keto privacy policy. Learn how we collect, use, and protect your personal information."
>
  <section class="mx-auto max-w-3xl px-4 pt-10 sm:px-6 sm:pt-14">
    <p class="badge badge-primary">Legal</p>
    <h1 class="mt-4 font-display text-4xl font-semibold text-primary sm:text-5xl">Privacy Policy</h1>
    <p class="mt-4 text-lg text-neutral-900/70">Last updated: August 2026</p>
  </section>

  <div class="mx-auto max-w-5xl px-4 pt-8 sm:px-6">
    <Photo
      slug="spice-box-topdown"
      class="aspect-[16/6] w-full rounded-3xl"
      widths={[480, 768, 1200]}
      sizes="(min-width: 1024px) 64rem, 100vw"
      eager={true}
    />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="prose prose-lg prose-keto">
      <p>Indian Keto ("we," "our," or "us") is committed to protecting your privacy. This policy explains how we collect, use and safeguard your information when you visit indianketo.com.</p>
      <h2>Information we collect</h2>
      <ul>
        <li><strong>Email address</strong> — only when you subscribe to our newsletter. Subscriptions are handled by Sequenzy, our email provider.</li>
        <li><strong>Usage data</strong> — pages visited, time on site and similar analytics via Google Analytics.</li>
      </ul>
      <h2>How we use your information</h2>
      <ul>
        <li>To send the newsletter you asked for, with Indian keto recipes and tips.</li>
        <li>To understand which guides are useful so we can improve them.</li>
      </ul>
      <p>We do not sell your personal information, and we do not share your email address with advertisers.</p>
      <h2>Cookies</h2>
      <p>We use cookies for analytics and basic site functionality. You can disable cookies in your browser settings; the site will still work.</p>
      <h2>Third-party services</h2>
      <p>We use Google Analytics for site analytics and Sequenzy for newsletter delivery. Each has its own privacy policy governing the data it processes.</p>
      <h2>Your choices</h2>
      <p>Every newsletter includes an unsubscribe link, and unsubscribing removes your address from our list. You can also email us to request deletion.</p>
      <h2>Contact</h2>
      <p>For questions about this policy, email <a href="mailto:hello@indianketo.com">hello@indianketo.com</a>.</p>
    </div>
  </section>
</BaseLayout>
