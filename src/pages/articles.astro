---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Photo from "@/components/Photo.astro";
import Icon from "@/components/Icon.astro";
import { getCollection } from "astro:content";
import type { PhotoSlug } from "@/data/photos";

const articles = (await getCollection("articles")).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate),
);
const [lead, ...rest] = articles;
---

<BaseLayout
  title="Indian Keto Articles — Guides, Recipes & Meal Plans"
  description="Browse our complete library of Indian keto articles. Expert guides on keto Indian food, recipes, meal plans, and low-carb Indian cooking tips."
>
  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
    <p class="badge badge-primary">Articles</p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold text-primary sm:text-5xl">
      Indian keto guides
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-900/70">
      {articles.length} long-form guides on eating keto with Indian food —
      technique first, macros stated, nothing padded out to hit a word count.
    </p>
  </section>

  <!-- Lead story gets the big treatment; the rest run as a card grid. -->
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <a
      href={`/articles/${lead.id}`}
      class="card group grid gap-0 lg:grid-cols-2 lg:items-stretch"
    >
      <Photo
        slug={lead.data.image as PhotoSlug}
        class="aspect-[16/9] w-full lg:aspect-auto lg:h-full"
        widths={[480, 768, 1024, 1280]}
        sizes="(min-width: 1024px) 38rem, 100vw"
      />
      <div class="card-body sm:p-8 lg:justify-center lg:p-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="badge badge-accent">Latest</span>
          <time datetime={lead.data.publishDate} class="text-sm text-neutral-900/55">
            {new Date(lead.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <h2 class="font-display text-2xl font-semibold text-primary sm:text-3xl">{lead.data.title}</h2>
        <p class="text-base text-neutral-900/70 sm:text-lg">{lead.data.description}</p>
        <span class="mt-2 inline-flex items-center gap-2 text-base font-semibold text-accent-700">
          Read article
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </span>
      </div>
    </a>

    <div class="mt-6 grid grid-cols-1 gap-6 sm:mt-8 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((a) => (
        <PostCard
          href={`/articles/${a.id}`}
          title={a.data.title}
          description={a.data.description}
          date={a.data.publishDate}
          photoSlug={a.data.image as PhotoSlug}
          kind="Article"
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 50vw, 100vw"
        />
      ))}
    </div>
  </section>
</BaseLayout>
