---
import BaseLayout from "@/layouts/BaseLayout.astro";

const articles = [
  { slug: "indian-keto-diet", title: "Indian Keto Diet: The Complete Beginner's Guide", description: "Everything you need to know about following a keto diet with Indian food — what to eat, what to avoid, and how to get started.", date: "2026-08-10" },
  { slug: "indian-keto-recipes", title: "25+ Indian Keto Recipes That Taste Authentic", description: "A curated collection of keto-friendly Indian recipes from butter chicken to cauliflower rice biryani — all under 10g net carbs.", date: "2026-08-09" },
  { slug: "indian-keto-meal-plan", title: "7-Day Indian Keto Meal Plan with Shopping List", description: "A complete week of Indian keto breakfast, lunch, and dinner with a printable shopping list. No guesswork required.", date: "2026-08-08" },
  { slug: "keto-paneer-recipes", title: "10+ Keto Paneer Recipes Under 5g Net Carbs", description: "Paneer is the ultimate keto protein. Discover delicious Indian paneer dishes that keep you in ketosis.", date: "2026-08-07" },
  { slug: "keto-cauliflower-rice-indian", title: "Keto Cauliflower Rice: Indian-Style Recipes & Tips", description: "Master cauliflower rice for Indian cooking — biryani, pulao, fried rice, and more. Tips for perfect texture every time.", date: "2026-08-06" },
  { slug: "indian-keto-snacks", title: "15 Indian Keto Snacks for When Hunger Strikes", description: "Quick and easy Indian keto snacks from masala nuts to paneer tikka. All ready in under 15 minutes.", date: "2026-08-05" },
  { slug: "indian-keto-breakfast", title: "Indian Keto Breakfast: 12 Recipes to Start Your Day", description: "From keto-friendly dosa to egg bhurji, these Indian keto breakfasts keep you full until lunch.", date: "2026-08-04" },
  { slug: "keto-roti-alternatives", title: "Keto Roti Alternatives: 6 Low-Carb Indian Breads", description: "Missing roti on keto? These almond flour, coconut flour, and psyllium husk flatbreads satisfy the craving.", date: "2026-08-03" },
];
---

<BaseLayout
  title="Indian Keto Articles — Guides, Recipes & Meal Plans"
  description="Browse our complete library of Indian keto articles. Expert guides on keto Indian food, recipes, meal plans, and low-carb Indian cooking tips."
>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-display font-semibold text-primary mb-4">Indian Keto Articles</h1>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Expert guides, recipes, and meal plans for following a keto diet with Indian food
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {articles.map((article) => (
          <a href={`/articles/${article.slug}`} class="card card-hover">
            <div class="card-body">
              <div class="flex items-center gap-2 mb-3">
                <span class="badge badge-primary">Article</span>
                <time class="text-sm text-neutral-500">{new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              </div>
              <h2 class="text-xl font-semibold text-primary mb-2">{article.title}</h2>
              <p class="text-neutral-600 text-sm">{article.description}</p>
              <div class="mt-4 flex items-center text-accent font-medium text-sm">
                <span>Read Article</span>
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
