---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const roundups = await getCollection("roundups");
  return roundups.map((roundup) => ({
    params: { slug: roundup.id },
    props: { roundup },
  }));
}

const { roundup } = Astro.props;
const { Content } = await render(roundup);

const productData = {
  title: roundup.data.title,
  description: roundup.data.description,
  brand: "Various",
  images: ["/images/og-default.png"],
  affiliateUrl: "#",
  price: "Varies",
  rating: 4.5,
  reviewCount: 1,
};
---

<BaseLayout
  title={roundup.data.title}
  description={roundup.data.description}
  canonical={`https://indianketo.com/roundups/${roundup.id}`}
>
  <Fragment slot="head">
    <StructuredData type="product" data={productData} />
  </Fragment>

  <article class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="badge badge-accent">Product Roundup</span>
          <time class="text-sm text-neutral-500">{new Date(roundup.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>
        <h1 class="text-4xl font-display font-semibold text-primary mb-4">{roundup.data.title}</h1>
        <p class="text-lg text-neutral-600">{roundup.data.description}</p>
      </header>

      <div class="prose-keto">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-neutral-200">
        <a href="/roundups" class="text-primary hover:text-primary-600 font-medium flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all roundups
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
