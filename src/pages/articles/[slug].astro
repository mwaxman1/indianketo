---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/StructuredData.astro";

export async function getStaticPaths() {
  // All article slugs
  const slugs = [
    "indian-keto-diet",
    "indian-keto-recipes",
    "indian-keto-meal-plan",
    "keto-paneer-recipes",
    "keto-cauliflower-rice-indian",
    "indian-keto-snacks",
    "indian-keto-breakfast",
    "keto-roti-alternatives",
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

// Article metadata lookup
const articles: Record<string, { title: string; description: string; author: string; publishDate: string }> = {
  "indian-keto-diet": {
    title: "Indian Keto Diet: The Complete Beginner's Guide (2026)",
    description: "Everything you need to know about following a keto diet with Indian food — what to eat, what to avoid, and how to get started with Indian keto.",
    author: "Indian Keto Team",
    publishDate: "2026-08-10",
  },
  "indian-keto-recipes": {
    title: "25+ Indian Keto Recipes That Taste Authentic (2026)",
    description: "A curated collection of keto-friendly Indian recipes from butter chicken to cauliflower rice biryani — all under 10g net carbs.",
    author: "Indian Keto Team",
    publishDate: "2026-08-09",
  },
  "indian-keto-meal-plan": {
    title: "7-Day Indian Keto Meal Plan with Shopping List (2026)",
    description: "A complete week of Indian keto breakfast, lunch, and dinner with a printable shopping list. No guesswork required.",
    author: "Indian Keto Team",
    publishDate: "2026-08-08",
  },
  "keto-paneer-recipes": {
    title: "10+ Keto Paneer Recipes Under 5g Net Carbs (2026)",
    description: "Paneer is the ultimate keto protein. Discover delicious Indian paneer dishes that keep you in ketosis.",
    author: "Indian Keto Team",
    publishDate: "2026-08-07",
  },
  "keto-cauliflower-rice-indian": {
    title: "Keto Cauliflower Rice: Indian-Style Recipes & Tips (2026)",
    description: "Master cauliflower rice for Indian cooking — biryani, pulao, fried rice, and more. Tips for perfect texture every time.",
    author: "Indian Keto Team",
    publishDate: "2026-08-06",
  },
  "indian-keto-snacks": {
    title: "15 Indian Keto Snacks for When Hunger Strikes (2026)",
    description: "Quick and easy Indian keto snacks from masala nuts to paneer tikka. All ready in under 15 minutes.",
    author: "Indian Keto Team",
    publishDate: "2026-08-05",
  },
  "indian-keto-breakfast": {
    title: "Indian Keto Breakfast: 12 Recipes to Start Your Day (2026)",
    description: "From keto-friendly dosa to egg bhurji, these Indian keto breakfasts keep you full until lunch.",
    author: "Indian Keto Team",
    publishDate: "2026-08-04",
  },
  "keto-roti-alternatives": {
    title: "Keto Roti Alternatives: 6 Low-Carb Indian Breads (2026)",
    description: "Missing roti on keto? These almond flour, coconut flour, and psyllium husk flatbreads satisfy the craving.",
    author: "Indian Keto Team",
    publishDate: "2026-08-03",
  },
};

const article = articles[slug as string];
if (!article) {
  return Astro.redirect("/404");
}

const articleData = {
  title: article.title,
  description: article.description,
  author: article.author,
  publishDate: article.publishDate,
  updatedDate: article.publishDate,
  url: `https://indianketo.com/articles/${slug}`,
};
---

<BaseLayout
  title={article.title}
  description={article.description}
  canonical={`https://indianketo.com/articles/${slug}`}
>
  <Fragment slot="head">
    <StructuredData type="article" data={articleData} />
  </Fragment>

  <article class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="badge badge-primary">Article</span>
          <time class="text-sm text-neutral-500">{new Date(article.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>
        <h1 class="text-4xl font-display font-semibold text-primary mb-4">{article.title}</h1>
        <p class="text-lg text-neutral-600">{article.description}</p>
      </header>

      <div class="prose-keto">
        <p><em>Full article content is being loaded. This is a placeholder for the complete {article.title.toLowerCase()} guide.</em></p>
        <p>This article covers everything you need to know about this topic, including detailed recipes, nutritional information, and practical tips for your Indian keto journey.</p>
        <p><a href="/articles">← Back to all articles</a></p>
      </div>
    </div>
  </article>
</BaseLayout>
