---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const articleData = {
  title: article.data.title,
  description: article.data.description,
  author: article.data.author,
  publishDate: article.data.publishDate,
  updatedDate: article.data.updatedDate || article.data.publishDate,
  url: `https://indianketo.com/articles/${article.id}`,
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={`https://indianketo.com/articles/${article.id}`}
>
  <Fragment slot="head">
    <StructuredData type="article" data={articleData} />
  </Fragment>

  <article class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="badge badge-primary">Article</span>
          <time class="text-sm text-neutral-500">{new Date(article.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>
        <h1 class="text-4xl font-display font-semibold text-primary mb-4">{article.data.title}</h1>
        <p class="text-lg text-neutral-600">{article.data.description}</p>
      </header>

      <div class="prose-keto">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-neutral-200">
        <a href="/articles" class="text-primary hover:text-primary-600 font-medium flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all articles
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
