---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/StructuredData.astro";
import Photo from "@/components/Photo.astro";
import Icon from "@/components/Icon.astro";
import { getCollection, render } from "astro:content";
import { photo, photos, type PhotoSlug } from "@/data/photos";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const slug = article.data.image;
const heroSlug = slug && slug in photos ? (slug as PhotoSlug) : null;
const credit = heroSlug ? photo(heroSlug) : null;

const articleData = {
  title: article.data.title,
  description: article.data.description,
  author: article.data.author,
  publishDate: article.data.publishDate,
  updatedDate: article.data.updatedDate || article.data.publishDate,
  url: `https://indianketo.com/articles/${article.id}`,
};

const dateLabel = new Date(article.data.publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={`https://indianketo.com/articles/${article.id}`}
  image={credit ? credit.src.src : undefined}
>
  <Fragment slot="head">
    <StructuredData type="article" data={articleData} />
  </Fragment>

  <article>
    <header class="mx-auto max-w-3xl px-4 pt-10 sm:px-6 sm:pt-14">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="badge badge-primary">Article</span>
        <time datetime={article.data.publishDate} class="text-sm text-neutral-900/55">{dateLabel}</time>
        <span class="text-sm text-neutral-900/55">· {article.data.author}</span>
      </div>
      <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-primary sm:text-5xl">
        {article.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-neutral-900/70 sm:text-xl">
        {article.data.description}
      </p>
    </header>

    {heroSlug && credit && (
      <figure class="mx-auto mt-8 max-w-5xl px-4 sm:px-6">
        <Photo
          slug={heroSlug}
          class="aspect-[16/9] w-full rounded-3xl"
          widths={[480, 768, 1200, 1600]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          eager={true}
        />
        <figcaption class="mt-3 flex items-start gap-2 text-sm text-neutral-900/55">
          <Icon name="camera" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>
            {credit.title} — {credit.creator},
            <a href={credit.sourceUrl} rel="nofollow noopener" class="inline-flex min-h-[44px] items-center underline decoration-accent-300 decoration-2 underline-offset-4">{credit.license.toUpperCase()}</a>
          </span>
        </figcaption>
      </figure>
    )}

    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
      <div class="prose prose-lg prose-keto">
        <Content />
      </div>

      <div class="mt-12 border-t border-cream-dark pt-8">
        <a href="/articles" class="btn btn-secondary">
          <Icon name="arrow-left" class="h-5 w-5" />
          Back to all articles
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
