              <span>Read Our Guides</span>
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/roundups"
              class="group inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary font-semibold text-lg rounded-md hover:bg-primary hover:text-white transition-all duration-300 focus:ring-2 focus:ring-accent focus:ring-offset-2"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>Product Roundups</span>
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="grid grid-cols-3 gap-6 text-center">
            <div class="group">
              <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center mx-auto mb-3 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-sm font-semibold text-primary">Expert Guides</div>
              <div class="text-xs text-neutral-600">8 Pillar Articles</div>
            </div>
            <div class="group">
              <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center mx-auto mb-3 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div class="text-sm font-semibold text-primary">Keto Approved</div>
              <div class="text-xs text-neutral-600">Authentic Flavors</div>
            </div>
            <div class="group">
              <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center mx-auto mb-3 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="text-sm font-semibold text-primary">Updated Weekly</div>
              <div class="text-xs text-neutral-600">Fresh Content</div>
            </div>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="relative mt-8 lg:mt-0">
          <div class="aspect-square rounded-lg overflow-hidden shadow-lg bg-primary-50 flex items-center justify-center">
            <div class="text-center p-8">
              <div class="text-8xl mb-4">🥘</div>
              <p class="text-primary font-display text-2xl font-semibold">Indian Keto</p>
              <p class="text-neutral-600 mt-2">Authentic Flavors, Low-Carb Lifestyle</p>
            </div>
          </div>
          <div class="absolute -top-2 -right-2 sm:-top-4 sm:-right-4 bg-accent text-white px-3 py-1.5 sm:px-4 sm:py-2 rounded-full font-semibold shadow-lg text-sm sm:text-base">
            🥑 Keto + Indian
          </div>
          <div class="absolute -bottom-2 -left-2 sm:-bottom-4 sm:-left-4 bg-white text-primary px-3 py-1.5 sm:px-4 sm:py-2 rounded-full font-semibold shadow-lg text-sm sm:text-base">
            🌿 8 Pillar Articles
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Articles Section -->
  <section class="py-16 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-display font-semibold text-primary mb-4">
          Essential Indian Keto Guides
        </h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Everything you need to know about following a keto diet with Indian food
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/articles/indian-keto-diet" class="card card-hover">
          <div class="card-body">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-primary mb-2">Indian Keto Diet Guide</h3>
            <p class="text-sm text-neutral-600">Complete beginner's guide to keto with Indian food</p>
          </div>
        </a>

        <a href="/articles/indian-keto-recipes" class="card card-hover">
          <div class="card-body">
            <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-primary mb-2">Indian Keto Recipes</h3>
            <p class="text-sm text-neutral-600">25+ authentic Indian dishes made keto-friendly</p>
          </div>
        </a>

        <a href="/articles/indian-keto-meal-plan" class="card card-hover">
          <div class="card-body">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-primary mb-2">Indian Keto Meal Plan</h3>
            <p class="text-sm text-neutral-600">7-day meal plan with Indian keto breakfast, lunch, dinner</p>
          </div>
        </a>

        <a href="/articles/keto-paneer-recipes" class="card card-hover">
          <div class="card-body">
            <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-primary mb-2">Keto Paneer Recipes</h3>
            <p class="text-sm text-neutral-600">10+ delicious paneer dishes under 5g net carbs</p>
          </div>
        </a>
      </div>

      <div class="text-center mt-12">
        <a
          href="/articles"
          class="bg-primary text-white px-8 py-3 rounded-lg hover:bg-primary-600 transition-colors font-semibold text-lg"
        >
          View All Articles
        </a>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <h2 class="text-2xl font-display font-semibold text-primary mb-3">Get Free Indian Keto Recipes Weekly</h2>
        <p class="text-neutral-600 mb-6 max-w-xl mx-auto">Join our newsletter for weekly Indian keto recipes, meal plans, and product recommendations.</p>
        <form class="kc-email-capture flex flex-col sm:flex-row gap-3 max-w-md mx-auto" data-status="idle">
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="flex-1 px-4 py-3 rounded-lg border border-neutral-300 text-neutral-900 placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-accent"
          />
          <input type="hidden" name="referrer" value="homepage" />
          <button
            type="submit"
            class="bg-accent hover:bg-accent-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors whitespace-nowrap"
          >
            Subscribe Free
          </button>
        </form>
        <p class="kc-email-note text-neutral-500 text-xs mt-3"></p>
      </div>
    </div>
  </section>

  <!-- How We Help Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-display font-semibold text-primary mb-4">
          How Indian Keto Helps You
        </h2>
        <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
          Practical, tested guidance for real people who love Indian food
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white border border-neutral-200 rounded-lg p-6 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="text-3xl font-semibold text-primary mb-1">8</div>
          <p class="text-neutral-600">In-depth pillar articles covering every aspect of Indian keto</p>
        </div>

        <div class="bg-white border border-neutral-200 rounded-lg p-6 shadow-sm">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
          </div>
          <div class="text-3xl font-semibold text-primary mb-1">4</div>
          <p class="text-neutral-600">Curated product roundups for your Indian keto kitchen</p>
        </div>

        <div class="bg-white border border-neutral-200 rounded-lg p-6 shadow-sm">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-3xl font-semibold text-primary mb-1">August 2026</div>
          <p class="text-neutral-600">Content reviewed and updated for accuracy this month</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
