---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import { getCollection } from "astro:content";
import { photo, type PhotoSlug } from "@/data/photos";

const articles = (await getCollection("articles")).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate),
);

const heroPhoto = photo("hero-paneer-karahi");

const trust = [
  { icon: "book-open", label: "8 pillar guides", detail: "Long-form, not listicles" },
  { icon: "spice-box", label: "Real spice technique", detail: "Tadka, bhuna, dum" },
  { icon: "check-badge", label: "Net carbs stated", detail: "Per dish, not per day" },
  { icon: "shield-check", label: "No paid placements", detail: "Affiliate links disclosed" },
];

const pantry = [
  {
    icon: "spice-box",
    title: "The masala dabba does the work",
    body: "Cumin, coriander, turmeric, garam masala, cardamom, cloves and fenugreek carry essentially no carbohydrate. Flavour is the one thing keto never has to take away from Indian cooking.",
  },
  {
    icon: "fire",
    title: "Ghee is the default fat",
    body: "It has a high smoke point, it is what the technique was built around, and it costs you nothing in carbs. Bloom whole spices in it before anything else goes in the pan.",
  },
  {
    icon: "sparkles",
    title: "Swap the starch, keep the dish",
    body: "Cauliflower for rice, almond and psyllium doughs for roti, cream and cashew-free thickeners for gravies that would otherwise lean on onion and tomato paste.",
  },
];

const homepageFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you eat Indian food on a keto diet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes! Many Indian dishes are naturally keto-friendly or can be easily adapted. Paneer dishes, tandoori meats, cauliflower rice biryani, and coconut-based curries are all excellent low-carb options. The key is avoiding rice, naan, roti, potatoes, and sugar-laden sauces while keeping the rich spice traditions of Indian cooking." }
    },
    {
      "@type": "Question",
      "name": "What are the best Indian keto recipes for beginners?",
      "acceptedAnswer": { "@type": "Answer", "text": "Start with keto paneer butter masala (use heavy cream instead of sugar), tandoori chicken, cauliflower rice pulao, egg curry, and palak paneer. These dishes are naturally low in carbs, high in fat and protein, and use ingredients you can find at any Indian grocery store." }
    },
    {
      "@type": "Question",
      "name": "Is paneer keto-friendly?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. Paneer is one of the best keto foods in Indian cuisine. A 100g serving contains approximately 25g protein, 20g fat, and only 1-2g net carbs. It's versatile, filling, and works in everything from curries to grilled skewers to scrambled 'egg' substitutes." }
    },
    {
      "@type": "Question",
      "name": "What can I use instead of rice and roti on keto?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cauliflower rice is the most popular rice substitute — it absorbs Indian spices beautifully. For roti alternatives, try almond flour roti, coconut flour paratha, or psyllium husk flatbreads. Many keto dieters also enjoy their curries with a side of sautéed greens or simply eat them as soup-like dishes." }
    },
    {
      "@type": "Question",
      "name": "How do I make keto Indian food taste authentic?",
      "acceptedAnswer": { "@type": "Answer", "text": "It comes down to the spices. Stock your pantry with cumin, coriander, turmeric, garam masala, cardamom, cloves, and fenugreek (methi). These spices are carb-free and deliver the authentic Indian flavors you love. Use ghee as your primary cooking fat — it's traditional, keto-friendly, and enhances every dish." }
    }
  ]
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Website",
  "name": "Indian Keto",
  "description": "Your guide to following a keto diet with Indian food. Authentic Indian keto recipes, meal plans, and product recommendations.",
  "url": "https://indianketo.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://indianketo.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title="Indian Keto — Your Guide to Keto Indian Food, Recipes & Meal Plans (2026)"
  description="Follow a keto diet with authentic Indian food. Keto Indian recipes, meal plans, product roundups, and expert guides for low-carb Indian cooking."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageFAQ)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-accent-50 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-accent-700">
          <Icon name="leaf" class="h-4 w-4" />
          Indian keto, reviewed August 2026
        </p>

        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.05] text-primary sm:text-5xl lg:text-6xl">
          Keto Indian food,
          <span class="relative inline-block text-accent-700">
            made delicious
            <svg class="absolute -bottom-1 left-0 h-3 w-full text-accent-200" viewBox="0 0 300 12" fill="currentColor" aria-hidden="true">
              <path d="M0,8 Q150,0 300,8 L300,12 L0,12 Z" />
            </svg>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-900/75 sm:text-xl">
          Stay in ketosis without giving up paneer, korma or a properly bloomed
          tadka. Tested recipes, seven-day plans and kit that earns its shelf space.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/articles" class="btn btn-primary btn-lg w-full sm:w-auto">
            Read our guides
            <Icon name="arrow-right" class="h-5 w-5" />
          </a>
          <a href="/roundups" class="btn btn-secondary btn-lg w-full sm:w-auto">
            <Icon name="book-open" class="h-5 w-5" />
            Product roundups
          </a>
        </div>
      </div>

      <div class="relative">
        <Photo
          slug="hero-paneer-karahi"
          class="aspect-[4/3] w-full rounded-3xl shadow-[0_30px_60px_-30px_rgba(15,17,17,0.5)] sm:aspect-[5/4] lg:aspect-[4/5]"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 40rem, 100vw"
          eager={true}
        />
        <p class="mt-3 flex items-start gap-2 text-sm text-neutral-900/55">
          <Icon name="camera" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>{heroPhoto.title} — {heroPhoto.creator}, {heroPhoto.license.toUpperCase()}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ── Trust strip ─────────────────────────────────────────────────────── -->
  <section class="border-y border-cream-dark bg-cream-dark/40" aria-label="What this site is">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 gap-x-6 gap-y-6 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
      {trust.map((t) => (
        <li class="flex items-start gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary text-accent-200">
            <Icon name={t.icon} class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-display text-lg font-semibold text-primary">{t.label}</span>
            <span class="block text-base text-neutral-900/65">{t.detail}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Featured guides ─────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-primary sm:text-4xl">
        Essential Indian keto guides
      </h2>
      <p class="mt-4 text-lg text-neutral-900/70">
        What to eat, what to leave on the shelf, and how to cook it so it still
        tastes like the food you grew up with.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {articles.map((a) => (
        <PostCard
          href={`/articles/${a.id}`}
          title={a.data.title}
          description={a.data.description}
          date={a.data.publishDate}
          photoSlug={a.data.image as PhotoSlug}
          kind="Article"
        />
      ))}
    </div>

    <div class="mt-10">
      <a href="/articles" class="btn btn-secondary btn-lg w-full sm:w-auto">
        View all articles
        <Icon name="arrow-right" class="h-5 w-5" />
      </a>
    </div>
  </section>

  <!-- ── Newsletter ──────────────────────────────────────────────────────── -->
  <section class="px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl bg-white px-5 py-12 shadow-[0_20px_50px_-30px_rgba(15,17,17,0.4)] sm:px-10 sm:py-14">
      <NewsletterSignup referrer="homepage" tone="light" />
    </div>
  </section>

  <!-- ── Wide band ───────────────────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden">
    <Photo
      slug="wide-chicken-skewers"
      class="absolute inset-0 -z-10 h-full w-full"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-primary-900/95 via-primary-900/70 to-primary-900/25"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 text-sm font-semibold uppercase tracking-wide text-accent-200">
          <Icon name="fire" class="h-4 w-4" />
          Kit that earns its shelf space
        </p>
        <h2 class="mt-5 font-display text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">
          A grinder, a heavy pan, and flour that behaves
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">
          Four roundups covering the tools that actually change the result:
          spice grinders, nonstick that survives high-heat tempering, low-carb
          flours that hold a dough, and cookbooks worth the counter space.
        </p>
        <a href="/roundups" class="btn btn-accent btn-lg mt-8 w-full sm:w-auto">
          See the roundups
          <Icon name="arrow-right" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Pantry / spice composition ──────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <h2 class="font-display text-3xl font-semibold text-primary sm:text-4xl">
          Your spice box is already keto
        </h2>
        <p class="mt-4 text-lg text-neutral-900/70">
          Nothing in the dabba needs replacing. The carbohydrate in Indian food
          lives in the rice, the roti and the sugar in the gravy — not in the
          masala.
        </p>

        <dl class="mt-8 flex flex-col gap-6">
          {pantry.map((p) => (
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-700">
                <Icon name={p.icon} class="h-5 w-5" />
              </span>
              <div>
                <dt class="font-display text-xl font-semibold text-primary">{p.title}</dt>
                <dd class="mt-1 text-base leading-relaxed text-neutral-900/70">{p.body}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <Photo
          slug="masala-dabba"
          class="col-span-2 aspect-[16/10] w-full rounded-3xl"
          widths={[480, 720, 1024]}
          sizes="(min-width: 1024px) 34rem, 100vw"
        />
        <Photo
          slug="ghee-jar"
          class="aspect-square w-full rounded-3xl"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 17rem, 50vw"
        />
        <Photo
          slug="spice-box-topdown"
          class="aspect-square w-full rounded-3xl"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 17rem, 50vw"
        />
        <Photo
          slug="whole-spices-plate"
          class="col-span-2 aspect-[16/8] w-full rounded-3xl"
          widths={[480, 720, 1024]}
          sizes="(min-width: 1024px) 34rem, 100vw"
        />
      </div>
    </div>
  </section>

</BaseLayout>
