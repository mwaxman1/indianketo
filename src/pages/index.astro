---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/StructuredData.astro";

const homepageFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you eat Indian food on a keto diet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes! Many Indian dishes are naturally keto-friendly or can be easily adapted. Paneer dishes, tandoori meats, cauliflower rice biryani, and coconut-based curries are all excellent low-carb options. The key is avoiding rice, naan, roti, potatoes, and sugar-laden sauces while embracing the rich spice traditions of Indian cooking." }
    },
    {
      "@type": "Question",
      "name": "What are the best Indian keto recipes for beginners?",
      "acceptedAnswer": { "@type": "Answer", "text": "Start with keto paneer butter masala (use heavy cream instead of sugar), tandoori chicken, cauliflower rice pulao, egg curry, and palak paneer. These dishes are naturally low in carbs, high in fat and protein, and use ingredients you can find at any Indian grocery store." }
    },
    {
      "@type": "Question",
      "name": "Is paneer keto-friendly?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. Paneer is one of the best keto foods in Indian cuisine. A 100g serving contains approximately 25g protein, 20g fat, and only 1-2g net carbs. It's versatile, filling, and works in everything from curries to grilled skewers to scrambled 'egg' substitutes." }
    },
    {
      "@type": "Question",
      "name": "What can I use instead of rice and roti on keto?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cauliflower rice is the most popular rice substitute — it absorbs Indian spices beautifully. For roti alternatives, try almond flour roti, coconut flour paratha, or psyllium husk flatbreads. Many keto dieters also enjoy their curries with a side of sautéed greens or simply eat them as soup-like dishes." }
    },
    {
      "@type": "Question",
      "name": "How do I make keto Indian food taste authentic?",
      "acceptedAnswer": { "@type": "Answer", "text": "The secret is in the spices. Stock your pantry with cumin, coriander, turmeric, garam masala, cardamom, cloves, and fenugreek (methi). These spices are carb-free and deliver the authentic Indian flavors you love. Use ghee as your primary cooking fat — it's traditional, keto-friendly, and enhances every dish." }
    }
  ]
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Website",
  "name": "Indian Keto",
  "description": "Your guide to following a keto diet with Indian food. Authentic Indian keto recipes, meal plans, and product recommendations.",
  "url": "https://indianketo.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://indianketo.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title="Indian Keto — Your Guide to Keto Indian Food, Recipes & Meal Plans (2026)"
  description="Discover how to follow a keto diet with authentic Indian food. Keto Indian recipes, meal plans, product roundups, and expert guides for low-carb Indian cooking."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageFAQ)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative bg-white overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 opacity-[0.02]">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')]"></div>
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24 xl:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center px-4 py-2 bg-accent/10 text-accent rounded-full text-sm font-semibold mb-6">
            <span class="w-2 h-2 bg-accent rounded-full mr-3"></span>
            Indian Keto Made Simple · Updated August 2026
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-display font-semibold leading-tight mb-6 text-primary">
            Keto Indian Food
            <span class="relative">
              <span class="text-accent">Made Delicious</span>
              <svg class="absolute -bottom-2 left-0 w-full h-3 text-accent/20" viewBox="0 0 300 12" fill="currentColor">
                <path d="M0,8 Q150,0 300,8 L300,12 L0,12 Z"/>
              </svg>
            </span>
          </h1>

          <p class="text-lg sm:text-xl text-neutral-700 leading-relaxed mb-8 max-w-xl">
            Discover how to enjoy authentic Indian flavors while staying in ketosis. Expert guides, tested recipes, and product recommendations for your low-carb Indian kitchen.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <a
              href="/articles"
              class="group inline-flex items-center justify-center px-8 py-4 bg-primary text-white font-semibold text-lg rounded-md hover:bg-primary-600 transition-all duration-300 shadow-lg hover:shadow-xl focus:ring-2 focus:ring-accent focus:ring-offset-2"
