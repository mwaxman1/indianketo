---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";
import type { PhotoSlug } from "@/data/photos";

const roundups = (await getCollection("roundups")).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate),
);
---

<BaseLayout
  title="Indian Keto Product Roundups — Best Tools & Ingredients"
  description="Curated product roundups for your Indian keto kitchen. Best cookbooks, spice grinders, keto flours, and cookware for low-carb Indian cooking."
>
  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
    <p class="badge badge-accent">Product Roundups</p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold text-primary sm:text-5xl">
      Kit for an Indian keto kitchen
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-900/70">
      {roundups.length} roundups, each one narrowed to the handful of products
      that change the result. Affiliate links are marked and disclosed.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h2 class="sr-only">All product roundups</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {roundups.map((r) => (
        <PostCard
          href={`/roundups/${r.id}`}
          title={r.data.title}
          description={r.data.description}
          date={r.data.publishDate}
          photoSlug={r.data.image as PhotoSlug}
          kind="Product Roundup"
        />
      ))}
    </div>
  </section>
</BaseLayout>
