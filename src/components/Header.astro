---
import Icon from "@/components/Icon.astro";

const links = [
  { href: "/articles", label: "Articles" },
  { href: "/roundups", label: "Product Roundups" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="sticky top-0 z-30 border-b border-cream-dark bg-cream/95 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="/" class="flex min-h-[44px] items-center gap-2.5" aria-label="Indian Keto — home">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-accent-200">
          <Icon name="leaf" class="h-5 w-5" />
        </span>
        <span class="font-display text-xl font-semibold leading-none text-primary sm:text-2xl">Indian&nbsp;Keto</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
            class:list={[
              "inline-flex min-h-[44px] items-center rounded-full px-4 text-base font-medium transition-colors",
              isCurrent(l.href)
                ? "bg-primary-50 text-primary"
                : "text-neutral-900/75 hover:bg-primary-50 hover:text-primary",
            ]}
          >
            {l.label}
          </a>
        ))}
        <a href="/articles" class="btn btn-primary ml-2">Start here</a>
      </nav>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-primary hover:bg-primary-50 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" data-icon="open" />
        <Icon name="close" class="hidden h-6 w-6" data-icon="close" />
      </button>
    </div>

    <div id="mobile-menu" class="hidden pb-4 md:hidden">
      <nav class="flex flex-col gap-2" aria-label="Mobile">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
            class:list={[
              "flex min-h-[52px] w-full items-center justify-between rounded-xl border px-4 text-lg font-medium",
              isCurrent(l.href)
                ? "border-primary bg-primary-50 text-primary"
                : "border-cream-dark bg-white text-neutral-900/80",
            ]}
          >
            {l.label}
            <Icon name="chevron-right" class="h-5 w-5 text-accent" />
          </a>
        ))}
        <a href="/articles" class="btn btn-primary btn-lg w-full">Start here</a>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      var o = btn.querySelector('[data-icon="open"]');
      var c = btn.querySelector('[data-icon="close"]');
      if (o) o.classList.toggle('hidden', open);
      if (c) c.classList.toggle('hidden', !open);
    });
  })();
</script>
