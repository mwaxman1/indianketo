export interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
  [key: string]: unknown;
}

const { name, class: className = 'h-6 w-6', strokeWidth = 1.75, ...rest } = Astro.props;
const paths = ICONS[name];
if (!paths) {
  throw new Error(`Icon "${name}" is not in the icon map (src/components/Icon.astro)`);
}
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {paths.map((d) => <path d={d} />)}
</svg>
