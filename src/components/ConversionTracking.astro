---
// ConversionTracking.astro — funnel events to GA4 and to the first-party ledger endpoint.
// Mount as the LAST element before </body>, after AnalyticsHead. No imports, no bundler: one inline script.
// `endpoint` is same-origin (credentials same-origin) or an https cross-origin collector (credentials omit);
// anything else disables the ledger.
//
// `consent` is the property's storage/consent posture — choose it per property, never by accident:
//   gate      (default) capture only after localStorage 'rr-analytics-consent' === 'accepted' (strict opt-in;
//             pair with ConsentBanner + AnalyticsHead).
//   notice    capture unless the visitor declined ('declined'); persistent ids. Use where the site shows an
//             opt-out analytics notice, because that is what the notice promises.
//   ephemeral capture immediately, mint a NEW random visitor id on every page load and write nothing to
//             storage — the "persistence: memory" posture, for a site with no consent UI at all.
// Every queued event carries the browser's coarse browser/OS family (browser_family / os_family): the server-side
// forward cannot invent them, and without them PostHog's $browser / $os / $device_type stay null on every row.
interface Props {
  endpoint?: string;
  property?: string;
  consent?: 'gate' | 'notice' | 'ephemeral';
}
const { endpoint = '/api/analytics/events', property = '', consent = 'gate' } = Astro.props;
// An unknown value must fail closed, not open: anything not understood is the strict opt-in gate.
const consented = consent === 'notice' || consent === 'ephemeral' ? consent : 'gate';
---

{property && <span hidden data-analytics-site={property}></span>}
<script is:inline define:vars={{ endpoint, property, consented }}>
  (function () {
    var CONSENT_KEY = 'rr-analytics-consent';
    var CONSENT_VERSION = 'rr-analytics-consent-v1';
    var VID_KEY = 'rr-analytics-vid';
    var SID_KEY = 'rr-analytics-sid';
    var VISIT_KEY = 'rr-visit-' + property;
    var SESSION_MS = 30 * 60 * 1000;
    var VID_MS = 90 * 24 * 60 * 60 * 1000;
    var BATCH = 20;
    var MAX_RETRIES = 3;
    var MAX_QUEUE = 200;
    var MAX_REJECT_WARNS = 3; // page-side drops reach devtools, but a broken page cannot flood the console
    var rejectWarns = 0;
    var VOCAB = ['page_view', 'cta_view', 'cta_click', 'form_start', 'form_submit', 'generate_lead', 'search', 'affiliate_click'];

    // Endpoint-aware credentials: same-origin keeps cookies; cross-origin must be https and never sends them.
    var creds = null;
    try {
      var eu = new URL(endpoint, location.href);
      creds = eu.origin === location.origin ? 'same-origin' : eu.protocol === 'https:' ? 'omit' : null;
    } catch (_) {}
    var ledger = !!(property && creds); // unsafe endpoint => ledger off: nothing queued, stored or sent

    var queue = [];
    var flushing = false;
    var retries = 0;
    var pageViewSent = false;
    var flushTimer = null; // one pending debounced flush, or null
    var explicitFormSubmit = (typeof WeakSet === 'function') ? new WeakSet() : null;

    function readConsent() {
      try { return localStorage.getItem(CONSENT_KEY); } catch (_) { return null; }
    }
    // gate = opt-in ('accepted' only). notice = opt-out (anything except 'declined'). ephemeral = no UI, no storage.
    function hasConsent() {
      if (consented === 'ephemeral') return true;
      var c = readConsent();
      return consented === 'notice' ? c !== 'declined' : c === 'accepted';
    }
    function readJson(key) {
      try { return JSON.parse(localStorage.getItem(key)); } catch (_) { return null; }
    }
    function uuid() {
      return (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
        : 'x' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
    }

    // Callers must have checked hasConsent(): this writes storage.
    function ids() {
      var now = Date.now();
      // ephemeral: a fresh id per page load, nothing written. No identifier survives the page view, so the same
      // visitor on two pages is two distinct ids — that is the trade for having no consent UI to ask.
      if (consented === 'ephemeral') return { vid: uuid(), sid: uuid(), ephemeral: true };
      var v = readJson(VID_KEY);
      if (!v || !v.id || !(v.exp > now)) v = { id: uuid(), exp: now + VID_MS };
      localStorage.setItem(VID_KEY, JSON.stringify(v));
      var s = readJson(SID_KEY);
      if (!s || !s.id || now - s.t > SESSION_MS) s = { id: uuid(), t: now };
      s.t = now;
      localStorage.setItem(SID_KEY, JSON.stringify(s));
      return { vid: v.id, sid: s.id, ephemeral: false };
    }

    // {s: sessionCount, t: lastActivityMs}; returning = an earlier session exists. Consent holders only.
    function isReturning() {
      if (!ledger || !hasConsent() || consented === 'ephemeral') return false;
      try {
        var now = Date.now();
        var v = readJson(VISIT_KEY);
        if (!v || typeof v.s !== 'number') v = { s: 1, t: now };
        else if (now - v.t > SESSION_MS) v = { s: v.s + 1, t: now };
        else v.t = now;
        localStorage.setItem(VISIT_KEY, JSON.stringify(v));
        return v.s > 1;
      } catch (_) { return false; }
    }

    function device() {
      var w = window.innerWidth;
      var coarse = window.matchMedia && matchMedia('(pointer:coarse)').matches;
      return w < 640 ? 'mobile' : (w < 1024 || coarse) ? 'tablet' : 'desktop';
    }

    // The one thing a server cannot infer about a visitor. Coarse, from the UA string only — no fingerprint, no
    // full UA. The collector maps these onto PostHog's own $browser/$os, which a server-side POST otherwise loses.
    function platform() {
      var ua = (typeof navigator !== 'undefined' && navigator.userAgent) || '';
      var b = /Edg\//.test(ua) ? 'Edge'
        : /OPR\/|Opera/.test(ua) ? 'Opera'
        : /Firefox\//.test(ua) ? 'Firefox'
        : /Chrome\/|CriOS/.test(ua) ? 'Chrome'
        : /Safari\//.test(ua) ? 'Safari'
        : 'Other';
      var o = /Windows/.test(ua) ? 'Windows'
        : /iPhone|iPad|iPod/.test(ua) ? 'iOS'
        : /Android/.test(ua) ? 'Android'
        : /Mac OS X/.test(ua) ? 'Mac OS X'
        : /Linux/.test(ua) ? 'Linux'
        : 'Other';
      return { browser_family: b, os_family: o };
    }

    function ga4(name, payload) {
      if (typeof window.gtag !== 'function' && Array.isArray(window.dataLayer)) {
        window.gtag = function () { window.dataLayer.push(arguments); };
      }
      if (typeof window.gtag === 'function') window.gtag('event', name, payload);
    }

    function enqueue(name, payload) {
      if (!ledger || !hasConsent()) return; // posture gate: nothing queued, stored or sent
      queue.push({ name: name, timestamp: new Date().toISOString(), page_path: payload.page_path, properties: payload });
      if (queue.length > MAX_QUEUE) queue.shift();
      if (queue.length >= BATCH) flush(false);
      if (!flushTimer) flushTimer = setTimeout(function () { flushTimer = null; flush(false); }, 700);
    }

    function flush(unloading) {
      if (flushing || !queue.length) return;
      if (!ledger || !hasConsent()) { clearTimeout(flushTimer); flushTimer = null; queue = []; return; } // withdrawn: discard and stop
      clearTimeout(flushTimer); flushTimer = null; // sending now; a pending timer would fire into the next queue
      flushing = true;
      var batch = queue.slice(0, BATCH);
      var id;
      try { id = ids(); } catch (_) { flushing = false; return; }
      var body = JSON.stringify({
        site_token: property,
        consent: { state: 'granted', version: CONSENT_VERSION },
        visitor_id: id.vid,
        session_id: id.sid,
        events: batch
      });
      function fail() {
        flushing = false;
        if (unloading || retries >= MAX_RETRIES) return; // kept; next flush trigger tries again
        retries += 1;
        setTimeout(function () { flush(false); }, 1000 * Math.pow(2, retries - 1));
      }
      try {
        fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: body,
          keepalive: true,
          credentials: creds
        }).then(function (res) {
          // Retry taxonomy. Most 4xx answers are TERMINAL for this batch: the collector has judged these exact
          // bytes and will answer the same way forever (400 site_token, 403 origin/consent, 404 endpoint,
          // 413 too_large, 422 every event dropped as PII). Retrying one only blocks the events queued behind
          // it, so drop the batch and let the rest of the page load through.
          //
          // 429 is the exception: rate limiting says nothing about the events, only about timing, so the batch
          // is kept and retried through fail()'s exponential backoff. Rate-limited events are exactly the ones
          // worth redelivering. 5xx and transport failures are transient in the same way.
          if (res.status >= 400 && res.status < 500 && res.status !== 429) {
            var dropped = batch.length;
            queue.splice(0, dropped);
            retries = 0;
            flushing = false;
            if (rejectWarns < MAX_REJECT_WARNS) {
              rejectWarns += 1;
              try {
                if (typeof console !== 'undefined' && console && console.warn) {
                  console.warn('[analytics] collector rejected the batch: HTTP ' + res.status +
                    ', dropped ' + dropped + ' event(s), ' + queue.length + ' still queued');
                }
              } catch (_) {}
            }
            if (queue.length) flush(unloading);
            return;
          }
          if (res.status !== 202) return fail();
          queue.splice(0, batch.length);
          retries = 0;
          flushing = false;
          if (queue.length) flush(unloading);
        }, fail);
      } catch (_) { fail(); }
    }

    function track(name, params, ledgerOnly) {
      try {
        if (VOCAB.indexOf(name) < 0) return;
        var payload = {};
        params = params || {};
        for (var k in params) if (k !== 'form' && Object.prototype.hasOwnProperty.call(params, k)) payload[k] = params[k];
        var form = params.form;
        if (form && form.nodeType === 1) {
          var sel = form.querySelector('select[name=service]');
          payload.form_id = form.id || '';
          payload.service = (sel && sel.value) || form.dataset.leadService || '';
          payload.field_count = form.elements ? form.elements.length : 0;
          // An explicit rrTrack('form_submit', {form}) call wins: the passive submit listener defers by a tick
          // and then skips this form, so one submission is one event either way.
          if (name === 'form_submit' && explicitFormSubmit) explicitFormSubmit.add(form);
        }
        payload.page_path = location.pathname;
        payload.device_category = device();
        var pf = platform();
        payload.browser_family = pf.browser_family;
        payload.os_family = pf.os_family;
        payload.is_returning = isReturning();
        // Passive emitters are ledger-only: the property site already sends its own GA4 event for the same click.
        // A query string never reaches gtag — the ledger keeps it, sanitize() is the guard there.
        if (name !== 'page_view' && !ledgerOnly) {
          var g = {};
          for (var gk in payload) if (gk !== 'search_query' && gk !== 'search_term' && Object.prototype.hasOwnProperty.call(payload, gk)) g[gk] = payload[gk];
          ga4(name, g); // gtag config already sends GA4's own page_view
        }
        enqueue(name, payload);
      } catch (_) { /* analytics must never break the page */ }
    }

    // ASSIGNED, not defined: AnalyticsHead may have a get/set accessor on window.rrTrack.
    window.rrTrack = track;

    function sendPageView() {
      if (pageViewSent || !hasConsent()) return;
      pageViewSent = true;
      track('page_view');
    }

    // Consent granted after load: same wrap pattern as AnalyticsHead.
    function onConsentChange() {
      try {
        if (hasConsent()) sendPageView();
        else { clearTimeout(flushTimer); flushTimer = null; queue = []; }
      } catch (_) {}
    }
    var previousGrant = window.grantAnalyticsConsent;
    window.grantAnalyticsConsent = function () {
      try { if (previousGrant) previousGrant.apply(this, arguments); } finally {
        onConsentChange();
        setTimeout(onConsentChange, 0); // banner may write storage just after calling us
      }
    };
    window.addEventListener('storage', function (e) {
      if (e.key === CONSENT_KEY) onConsentChange();
    });

    // cta_view: once per data-cta-id per page view
    try {
      var seen = {};
      var viewed = function (el) {
        var id = el.getAttribute('data-cta-id');
        if (!id || seen[id]) return;
        seen[id] = true;
        track('cta_view', { cta_id: id, cta_location: el.getAttribute('data-cta-location') || '' });
      };
      var ctas = document.querySelectorAll('[data-cta-id]');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { viewed(en.target); io.unobserve(en.target); }
          });
        }, { threshold: 0.5 });
        ctas.forEach(function (el) { io.observe(el); });
      } else {
        ctas.forEach(viewed);
      }

      document.addEventListener('click', function (e) {
        try {
          var el = e.target && e.target.closest && e.target.closest('[data-cta-id]');
          if (el) track('cta_click', { cta_id: el.getAttribute('data-cta-id'), cta_location: el.getAttribute('data-cta-location') || '' });
        } catch (_) {}
      }, true);

      var started = new WeakSet();
      document.addEventListener('focusin', function (e) {
        try {
          var f = e.target && e.target.closest && e.target.closest('form[data-lead-form]');
          if (f && !started.has(f)) { started.add(f); track('form_start', { form: f }); }
        } catch (_) {}
      });

      // lead_submit: every form marked data-lead-form, without touching the site's submit handler.
      // Capture phase + deferred a tick, so a page that also calls rrTrack('form_submit') itself wins.
      document.addEventListener('submit', function (e) {
        try {
          var f = e.target;
          if (!f || f.nodeType !== 1 || !f.matches || !f.matches('form[data-lead-form]')) return;
          setTimeout(function () {
            try { if (!explicitFormSubmit || !explicitFormSubmit.has(f)) track('form_submit', { form: f }); } catch (_) {}
          }, 0);
        } catch (_) {}
      }, true);

      // search: a site-search form that already exists. The query is bounded and never sent for a
      // PII-shaped string — sanitize drops the whole event rather than storing an address or phone.
      document.addEventListener('submit', function (e) {
        try {
          var f = e.target;
          if (!f || f.nodeType !== 1 || !f.matches || !f.matches('form[role=search], form[data-site-search]')) return;
          // data-tracking-manual="true": the site tracks this form itself — emit nothing, not even to the ledger.
          if ((f.getAttribute('data-tracking-manual') || '').toLowerCase() === 'true') return;
          var i = f.querySelector('input[type=search], input[name=q], input[name=s], input[name=query]');
          var v = (i && i.value) || '';
          if (!v) return;
          track('search', {
            search_query: v.slice(0, 80),
            search_source: f.getAttribute('data-site-search') || 'site'
          }, true);
        } catch (_) {}
      }, true);

      // affiliate_click: an outbound link marked data-affiliate="<partner>", or one that is recognisably an
      // affiliate/tracked outbound link. Only the partner slug and the placement are sent — never the URL,
      // which is where an affiliate id or a search term would leak.
      // The selector also covers non-anchor controls — a button that opens the buy URL itself — so a sticky
      // buy bar marked data-affiliate still reaches the ledger. data-tracking-manual="true" still wins.
      var AFFILIATE_HOSTS = ['amzn.to', 'amazon.', 'awin1.com', 'shareasale.com', 'impact.com', 'anrdoezrs.net',
        'dpbolvw.net', 'jdoqocy.com', 'kqzyfj.com', 'tkqlhce.com', 'cj.com', 'rakuten.com', 'click.linksynergy.com',
        'goto.walmart.com', 'rover.ebay.com', 'prf.hn', 'partnerize.com', 'sovrn.com', 'viglink.com'];
      function affiliatePartner(a) {
        var marked = (a.getAttribute('data-affiliate') || '').trim();
        // data-affiliate="true" is a marker, not a partner slug: fall through to the href/host derivation.
        if (marked && marked.toLowerCase() !== 'true') return marked;
        var href = a.getAttribute('href') || '';
        if (!/^https?:/i.test(href)) return '';
        var host, query;
        try { var u = new URL(href, location.href); host = u.hostname.toLowerCase(); query = u.search.toLowerCase(); }
        catch (_) { return ''; }
        if (host === location.hostname) return '';
        // Amazon Associates: the tag=<id>-20 parameter is the referral marker.
        if (/[?&]tag=[a-z0-9-]+-20\b/.test(query)) return 'amazon';
        for (var k = 0; k < AFFILIATE_HOSTS.length; k += 1) {
          var pat = AFFILIATE_HOSTS[k];
          if (pat.indexOf('.') === pat.length - 1 ? host.indexOf(pat) === 0 : host === pat || host.slice(-(pat.length + 1)) === '.' + pat) {
            return host.replace(/^www\./, '').split('.')[0] || 'affiliate';
          }
        }
        return '';
      }
      document.addEventListener('click', function (e) {
        try {
          var a = e.target && e.target.closest && e.target.closest('a[href], [data-affiliate]');
          if (!a) return;
          // data-tracking-manual="true": the site tracks this link itself — emit nothing, not even to the ledger.
          if ((a.getAttribute('data-tracking-manual') || '').toLowerCase() === 'true') return;
          var partner = affiliatePartner(a);
          if (!partner) return;
          track('affiliate_click', {
            partner: String(partner).slice(0, 40),
            placement: a.getAttribute('data-affiliate-placement') || a.getAttribute('data-cta-location') || 'link'
          }, true);
        } catch (_) {}
      }, true);

      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') flush(true);
      });
      window.addEventListener('pagehide', function () { flush(true); });
    } catch (_) {}

    sendPageView();
  })();
</script>
