---
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import Icon from "@/components/Icon.astro";
import { photos } from "@/data/photos";

const columns = [
  {
    heading: "Resources",
    items: [
      { href: "/articles", label: "Articles" },
      { href: "/roundups", label: "Product Roundups" },
    ],
  },
  {
    heading: "Company",
    items: [
      { href: "/about", label: "About Us" },
      { href: "/contact", label: "Contact" },
      { href: "/disclosure", label: "Affiliate Disclosure" },
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/terms", label: "Terms of Service" },
    ],
  },
  {
    heading: "Popular Topics",
    items: [
      { href: "/articles/indian-keto-diet", label: "Indian Keto Diet Guide" },
      { href: "/articles/indian-keto-recipes", label: "Indian Keto Recipes" },
      { href: "/articles/indian-keto-meal-plan", label: "Indian Keto Meal Plan" },
      { href: "/articles/keto-paneer-recipes", label: "Keto Paneer Recipes" },
    ],
  },
];

const photoCount = Object.keys(photos).length;
---

<footer class="mt-auto bg-primary text-white">
  <div class="bg-primary-800">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <NewsletterSignup referrer="footer" tone="dark" />
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-accent-200">
            <Icon name="leaf" class="h-5 w-5" />
          </span>
          <span class="font-display text-xl font-semibold">Indian Keto</span>
        </div>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-primary-100">
          Keto Indian food without the compromise — tested recipes, honest kit
          recommendations, and guides that respect the spice box.
        </p>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.heading}>
          <h2 class="font-display text-lg font-semibold text-white">{col.heading}</h2>
          <ul class="mt-4 flex flex-col gap-1">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-[44px] items-center text-base text-primary-100 hover:text-white hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-8 text-base text-primary-100 md:flex-row md:items-center md:justify-between">
      <p>&copy; 2026 Indian Keto. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <Icon name="camera" class="h-5 w-5 shrink-0 text-accent-200" />
        <span>
          All {photoCount} photographs are licence-cleared —
          <a
            href="/disclosure"
            class="inline-flex min-h-[44px] items-center font-semibold text-accent-200 underline decoration-accent-400 decoration-2 underline-offset-4 hover:text-white"
          >photo credits &amp; licences</a>.
        </span>
      </p>
    </div>
  </div>
</footer>
