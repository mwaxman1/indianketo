---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StructuredData from "@/components/StructuredData.astro";
import { photo } from "@/data/photos";
import "@/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  skipStructuredData?: boolean;
  hideGlobalNav?: boolean;
}

const ogFallback = photo("og-default");

const {
  title = "Indian Keto — Your Guide to Keto Indian Food & Recipes",
  description = "Follow a keto diet with Indian food. Authentic Indian keto recipes, meal plans, product recommendations, and expert guides for low-carb Indian cooking.",
  image = ogFallback.src.src,
  canonical,
  noindex = false,
  skipStructuredData = false,
  hideGlobalNav = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Vercel Web Analytics: first-party, cookieless; script is served by the
         Vercel platform at /_vercel/insights/script.js, not by the build output,
         so it must stay is:inline and is never bundled or rewritten. -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>

    <!-- Self-hosted fonts. @font-face lives in global.css; these are the three
         faces used above the fold, so they are fetched with the stylesheet. -->
    <link rel="preload" href="/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-600.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function() {
        var path = window.location.pathname;
        if (path !== '/' && path.endsWith('/')) {
          var newPath = path.slice(0, -1);
          var newUrl = window.location.origin + newPath + window.location.search + window.location.hash;
          window.location.replace(newUrl);
        }
      })();
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <meta name="keywords" content="indian keto, keto indian food, indian keto recipes, keto indian diet, low carb indian food, keto paneer, keto cauliflower rice, indian keto meal plan" />
    <meta name="author" content="Indian Keto Team" />
    <meta name="publisher" content="Indian Keto" />
    <meta name="language" content="en-US" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Indian Keto" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@indianketo" />
    <meta name="twitter:creator" content="@indianketo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#1B5E20" />
    <meta name="msapplication-TileColor" content="#1B5E20" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {!skipStructuredData && (
      <>
        <StructuredData type="website" />
        <StructuredData type="organization" />
      </>
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-cream font-body text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only top-3 left-3 focus:absolute focus:z-50 focus:inline-flex focus:min-h-[44px] focus:items-center focus:rounded-full focus:bg-primary focus:px-5 focus:text-white"
    >
      Skip to main content
    </a>

    {!hideGlobalNav && (
      <div class="bg-primary-800 text-white">
        <p class="mx-auto max-w-7xl px-4 py-2.5 text-center text-sm leading-snug">
          This site contains affiliate links — we may earn a commission when you buy.
          <a href="/disclosure" class="ml-1 inline-flex min-h-[44px] items-center font-semibold text-accent-200 underline decoration-accent-400 decoration-2 underline-offset-4 hover:text-white">Learn more</a>
        </p>
      </div>
    )}

    {!hideGlobalNav && <Header />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    {!hideGlobalNav && <Footer />}

    <!-- Deferred GA4 -->
    <script is:inline>
      var gaId = 'G-TR0TGL1NGM';
      function loadAnalytics() {
        if (gaId && gaId !== 'G-XXXXXXXXXX') {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, {
            page_title: document.title,
            page_location: window.location.href,
            send_page_view: true
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadAnalytics);
      } else {
        loadAnalytics();
      }
    </script>
  </body>
</html>
